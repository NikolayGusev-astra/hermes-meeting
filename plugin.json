{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "meeting-intelligence",
  "version": "0.8.0",
  "description": "Local-first meeting intelligence: Whisper transcription, translation, and verified protocol extraction.",
  "license": "MIT",
  "repository": "https://gitflic.ru/project/manve-sulimo2/hermes-meeting",
  "keywords": ["meeting", "transcription", "whisper", "protocol", "agent-plugins"],
  "python_dependencies": [
    "faster-whisper>=1.2,<2",
    "openai>=1,<3",
    "requests>=2.32,<3",
    "python-docx>=1.1,<2",
    "python-dotenv>=1.0,<2",
    "tenacity>=8.2,<10"
  ],
  "extensions": {
    "ru.hermes": {
      "entrypoint": "meeting_intelligence.plugin:register"
    },
    "com.hermes.desktop": {
      "plugin_entry": "com.hermes.desktop/plugin.js"
    }
  }
}
